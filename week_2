      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LinearRegression, LogisticRegression\n",
        "from sklearn.metrics import mean_squared_error, r2_score, accuracy_score, roc_curve, auc\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# ===================================================================\n",
        "# TASK 1: Linear Regression — Residual Plot\n",
        "# ===================================================================\n",
        "print(\"--- TASK 1: Linear Regression (Boston Housing) ---\")\n",
        "\n",
        "df_boston = pd.read_csv('boston.csv')\n",
        "if 'Unnamed: 0' in df_boston.columns:\n",
        "    df_boston.drop(columns=['Unnamed: 0'], inplace=True)\n",
        "\n",
        "target_col = 'MEDV' if 'MEDV' in df_boston.columns else df_boston.columns[-1]\n",
        "X_house = df_boston.drop(columns=[target_col])\n",
        "y_house = df_boston[target_col]\n",
        "\n",
        "X_train_h, X_test_h, y_train_h, y_test_h = train_test_split(X_house, y_house, test_size=0.2, random_state=42)\n",
        "\n",
        "lr_model = LinearRegression()\n",
        "lr_model.fit(X_train_h, y_train_h)\n",
        "\n",
        "y_pred_h = lr_model.predict(X_test_h)\n",
        "residuals = y_test_h - y_pred_h\n",
        "\n",
        "print(f\"Mean Squared Error (MSE): {mean_squared_error(y_test_h, y_pred_h):.4f}\")\n",
        "print(f\"R² Score: {r2_score(y_test_h, y_pred_h):.4f}\")\n",
        "\n",
        "# Plot Residuals (Errors vs Predicted Values)\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.scatter(y_pred_h, residuals, alpha=0.6, color='purple')\n",
        "plt.axhline(y=0, color='r', linestyle='--')\n",
        "plt.title('Residual Plot (Prediction Errors)')\n",
        "plt.xlabel('Predicted House Prices')\n",
        "plt.ylabel('Residuals (Actual - Predicted)')\n",
        "plt.show()\n",
        "\n",
        "# ===================================================================\n",
        "# TASK 2: Logistic Regression — ROC Curve Plot\n",
        "# ===================================================================\n",
        "print(\"\\n--- TASK 2: Logistic Regression (Titanic Survival) ---\")\n",
        "\n",
        "titanic_url = \"https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv\"\n",
        "df_titanic = pd.read_csv(titanic_url)\n",
        "\n",
        "df_titanic['Age'] = df_titanic['Age'].fillna(df_titanic['Age'].median())\n",
        "df_titanic['Embarked'] = df_titanic['Embarked'].fillna(df_titanic['Embarked'].mode()[0])\n",
        "df_titanic['Fare'] = df_titanic['Fare'].fillna(df_titanic['Fare'].median())\n",
        "\n",
        "label_enc = LabelEncoder()\n",
        "df_titanic['Sex'] = label_enc.fit_transform(df_titanic['Sex'])\n",
        "\n",
        "features = ['Pclass', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare']\n",
        "X_titanic = df_titanic[features]\n",
        "y_titanic = df_titanic['Survived']\n",
        "\n",
        "X_train_t, X_test_t, y_train_t, y_test_t = train_test_split(X_titanic, y_titanic, test_size=0.2, random_state=42)\n",
        "\n",
        "log_model = LogisticRegression(max_iter=500)\n",
        "log_model.fit(X_train_t, y_train_t)\n",
        "\n",
        "# ROC Curve evaluation\n",
        "y_probs = log_model.predict_proba(X_test_t)[:, 1]\n",
        "fpr, tpr, _ = roc_curve(y_test_t, y_probs)\n",
        "roc_auc = auc(fpr, tpr)\n",
        "\n",
        "print(f\"Accuracy: {accuracy_score(y_test_t, log_model.predict(X_test_t)) * 100:.2f}%\")\n",
        "print(f\"ROC AUC Score: {roc_auc:.4f}\")\n",
        "\n",
        "# Plot ROC Curve\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC curve (AUC = {roc_auc:.2f})')\n",
        "plt.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--')\n",
        "plt.title('ROC Curve - Titanic Survival Model')\n",
        "plt.xlabel('False Positive Rate')\n",
        "plt.ylabel('True Positive Rate')\n",
        "plt.legend(loc='lower right')\n",
        "plt.show()"
      ],
