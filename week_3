    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import joblib\n",
        "from scipy.spatial import ConvexHull\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# ===================================================================\n",
        "# 1. LOAD DATASET & PREPROCESSING\n",
        "# ===================================================================\n",
        "df = pd.read_csv('Iris.csv')\n",
        "\n",
        "if 'Id' in df.columns:\n",
        "    df.drop(columns=['Id'], inplace=True)\n",
        "\n",
        "target_col = 'Species' if 'Species' in df.columns else df.columns[-1]\n",
        "X_raw = df.drop(columns=[target_col])\n",
        "\n",
        "label_enc = LabelEncoder()\n",
        "y = label_enc.fit_transform(df[target_col])\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X_raw)\n",
        "\n",
        "# ===================================================================\n",
        "# 2. CUSTOM ELBOW PLOT (Area Fill + Point Marker)\n",
        "# ===================================================================\n",
        "wcss = []\n",
        "k_range = range(1, 11)\n",
        "\n",
        "for k in k_range:\n",
        "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
        "    kmeans.fit(X_scaled)\n",
        "    wcss.append(kmeans.inertia_)\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "plt.fill_between(k_range, wcss, color='skyblue', alpha=0.4)\n",
        "plt.plot(k_range, wcss, color='Slateblue', alpha=0.8, linewidth=3, marker='o', markersize=8)\n",
        "plt.axvline(x=3, color='crimson', linestyle='--', label='Elbow Point (k=3)')\n",
        "plt.title('Elbow Method (Variance Area View)')\n",
        "plt.xlabel('Number of Clusters (K)')\n",
        "plt.ylabel('WCSS (Inertia)')\n",
        "plt.legend()\n",
        "plt.grid(True, linestyle=':', alpha=0.6)\n",
        "plt.show()\n",
        "\n",
        "# ===================================================================\n",
        "# 3. K-MEANS & PCA\n",
        "# ===================================================================\n",
        "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
        "clusters = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "pca = PCA(n_components=2)\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "\n",
        "df_pca = pd.DataFrame(X_pca, columns=['PCA 1', 'PCA 2'])\n",
        "df_pca['Cluster'] = clusters\n",
        "df_pca['Species'] = df[target_col]\n",
        "\n",
        "# ===================================================================\n",
        "# 4. ADVANCED VISUALIZATIONS\n",
        "# ===================================================================\n",
        "\n",
        "# GRAPH 1: Cluster Boundaries using Convex Hulls\n",
        "plt.figure(figsize=(8, 6))\n",
        "colors = ['#FF5733', '#33FF57', '#3357FF']\n",
        "\n",
        "for i in range(3):\n",
        "    points = df_pca[df_pca['Cluster'] == i][['PCA 1', 'PCA 2']].values\n",
        "    plt.scatter(points[:, 0], points[:, 1], color=colors[i], label=f'Cluster {i}', s=50, alpha=0.8)\n",
        "\n",
        "    # Draw Convex Hull around cluster points\n",
        "    if len(points) > 2:\n",
        "        hull = ConvexHull(points)\n",
        "        for simplex in hull.simplices:\n",
        "            plt.plot(points[simplex, 0], points[simplex, 1], color=colors[i], lw=2)\n",
        "        plt.fill(points[hull.vertices, 0], points[hull.vertices, 1], color=colors[i], alpha=0.15)\n",
        "\n",
        "# Plot Centroids\n",
        "centroids_pca = pca.transform(kmeans.cluster_centers_)\n",
        "plt.scatter(centroids_pca[:, 0], centroids_pca[:, 1], c='black', s=250, marker='*', label='Centroids', zorder=10)\n",
        "plt.title('K-Means Cluster Boundaries (Convex Hull Enclosures)')\n",
        "plt.xlabel('PCA Component 1')\n",
        "plt.ylabel('PCA Component 2')\n",
        "plt.legend()\n",
        "plt.grid(True, linestyle=':', alpha=0.5)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# GRAPH 2: Parallel Coordinates Plot (Comparing Features by Species)\n",
        "plt.figure(figsize=(10, 5))\n",
        "pd.plotting.parallel_coordinates(df, target_col, colormap='Set2', alpha=0.6, linewidth=2)\n",
        "plt.title('Parallel Coordinates View: Feature Profiles across True Species')\n",
        "plt.xticks(rotation=15)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "# ===================================================================\n",
        "# 5. MODEL SAVING & LOADING\n",
        "# ===================================================================\n",
        "joblib.dump(kmeans, 'kmeans_iris_model.pkl')\n",
        "joblib.dump(scaler, 'scaler_iris.pkl')\n",
        "print(\"\\nModel and Scaler saved successfully!\")"
      ],
