      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# ASSIGNMENT 1: Load dataset and summarize basic stats\n",
        "# -------------------------------------------------------------------\n",
        "# Load the Titanic dataset uploaded in session storage\n",
        "df = pd.read_csv('Titanic-Dataset.csv')\n",
        "\n",
        "print(\"--- Dataset Info ---\")\n",
        "df.info()\n",
        "\n",
        "print(\"\\n--- Summary Statistics ---\")\n",
        "print(df.describe(include='all'))\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# ASSIGNMENT 2 & MINI PROJECT: Handle Missing Data\n",
        "# -------------------------------------------------------------------\n",
        "# Fill missing 'Age' using median imputation\n",
        "df['Age'] = df['Age'].fillna(df['Age'].median())\n",
        "\n",
        "# Fill missing 'Embarked' using mode imputation\n",
        "df['Embarked'] = df['Embarked'].fillna(df['Embarked'].mode()[0])\n",
        "\n",
        "# Drop 'Cabin' column due to excessive missing values (optional cleanup)\n",
        "if 'Cabin' in df.columns:\n",
        "    df.drop(columns=['Cabin'], inplace=True)\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# ASSIGNMENT 3 & MINI PROJECT: Encode Categorical Variables\n",
        "# -------------------------------------------------------------------\n",
        "# Label Encoding for 'Sex' (Binary: male -> 1, female -> 0)\n",
        "label_enc = LabelEncoder()\n",
        "df['Sex_Encoded'] = label_enc.fit_transform(df['Sex'])\n",
        "\n",
        "# One-Hot Encoding for 'Embarked' (Multi-class: C, Q, S)\n",
        "df = pd.get_dummies(df, columns=['Embarked'], prefix='Embarked', drop_first=False)\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# MINI PROJECT TASK: Visualize Age Distribution (Option 2: Survived vs Not Survived)\n",
        "# -------------------------------------------------------------------\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.kdeplot(data=df, x='Age', hue='Survived', common_norm=False, palette='Set1', fill=True)\n",
        "plt.title('Age Distribution: Survived vs Not Survived')\n",
        "plt.xlabel('Age')\n",
        "plt.ylabel('Density')\n",
        "plt.show()\n",
        "\n",
        "# -------------------------------------------------------------------\n",
        "# MINI PROJECT TASK: Output Cleaned Dataset as new CSV\n",
        "# -------------------------------------------------------------------\n",
        "df.to_csv('cleaned_titanic_dataset.csv', index=False)\n",
        "print(\"\\nCleaned dataset successfully saved as 'cleaned_titanic_dataset.csv'!\")"
      ],
